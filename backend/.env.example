PORT=5000
NODE_ENV=development

# Database - PostgreSQL
# Hosted database (Supabase): set DATABASE_URL and the DB_* lines below are ignored.
# On Vercel use Supabase's Transaction pooler link (port 6543).
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:6543/postgres
# DB_POOL_MAX=3

# Local database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=integra_advisory
DB_USER=postgres
DB_PASSWORD=postgres

# File uploads - Supabase Storage (required on Vercel, whose servers do not keep files).
# Leave empty to save uploads in backend/uploads on this computer.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_KEY=<secret key from Supabase > Project Settings > API Keys; never put it in the frontend>
# SUPABASE_BUCKET=uploads

# CORS: the website and admin addresses, comma separated
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Auth - JWT (use a long random value in production)
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d

# Admin credentials (seed): used only when the admins table is empty
ADMIN_EMAIL=admin@integra.com
ADMIN_PASSWORD=admin123
